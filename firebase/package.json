{
  "name": "astronode-firebase",
  "private": true,
  "description": "AstroNode Firebase güvenlik kuralları ve testleri",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-astronode \"node --test --test-concurrency=1 test/*.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0"
  }
}
